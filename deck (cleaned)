#include <stdlib.h>
#include <time.h>
#include "deck.h"

char* drawCard() {

    static int deck[52];
    static int initialized = 0;
    static int index = 0;
    static char drawnCard[3];

    char suits[] = {'h', 'd', 'c', 's'};
    char ranks[] = {'2', '3', '4', '5',
                    '6', '7', '8', '9',
                    'T', 'J', 'Q', 'K', 'A'};

    // Initialize and shuffle once
    if (!initialized) {

        srand(time(NULL));

        for (int i = 0; i < 52; i++)
            deck[i] = i;

        // Shuffle
        for (int i = 0; i < 52; i++) {

            int j = rand() % 52;

            int temp = deck[i];
            deck[i] = deck[j];
            deck[j] = temp;
        }

        initialized = 1;
    }

    // Reshuffle when empty
    if (index >= 52) {
        initialized = 0;
        index = 0;
        return drawCard();
    }

    int card = deck[index++];

    int suitIndex = card / 13;
    int rankIndex = card % 13;

    drawnCard[0] = ranks[rankIndex];
    drawnCard[1] = suits[suitIndex];
    drawnCard[2] = '\0';

    return drawnCard;
}
